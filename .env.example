# Copia este archivo como ".env" y ajusta valores si hace falta.
# .env NUNCA debe subirse al repositorio (ver .gitignore).
#
# OLLAMA_MODEL: se deja "phi3:mini" por defecto (modelo liviano, ~3.8B) para
# garantizar que el proyecto corra en máquinas con recursos limitados, como
# pide el requisito de ejecutarlo "en una máquina distinta a la del equipo".
# Si tu computadora tiene más recursos (GPU dedicada, mucha RAM), puedes
# cambiarlo localmente a un modelo más grande como "llama3.1:8b" para mejor
# calidad de respuesta, pero NO cambies este archivo de ejemplo — solo tu
# copia local ".env".

OLLAMA_MODEL=phi3:mini
OLLAMA_HOST=http://localhost:11434
WHISPER_MODEL_SIZE=base
TTS_VOICE=es-ES-AlvaroNeural
MAX_HISTORY_TURNS=10
WAKE_WORD=oye kry
SILENCE_SECONDS=1.5
COMMAND_MAX_SECONDS=20

# Modo de conversación continua: tras cada respuesta, Kry sigue
# escuchando el siguiente turno SIN pedir de nuevo "Oye Kry...".
# CONVERSATION_WINDOW_SECONDS: ventana total de la charla (se renueva
# cada vez que hablas). CONVERSATION_TURN_TIMEOUT: cuánto espera, en
# cada turno, a que empieces a hablar antes de asumir que terminaste.
CONVERSATION_WINDOW_SECONDS=180
CONVERSATION_TURN_TIMEOUT=8
